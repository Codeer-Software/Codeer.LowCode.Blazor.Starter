{
  // VS Code launch settings (C# Dev Kit / ms-dotnettools.csharp). Default variant: Cookie.
  // The public host is Cookie. Using another host under Source/Hosts (maintenance only)? Replace "Cookie" in this file (the Designer entry is shared).
  // The Designer entry opens DesignProjects/App/design; replace "App" with your design project folder.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Source/Hosts/Cookie/LowCodeApp.Server/bin/Debug/net8.0/LowCodeApp.Server.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Source/Hosts/Cookie/LowCodeApp.Server",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7137;http://localhost:5085"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Designer",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Source/Hosts/Common/LowCodeApp.Designer/bin/Debug/net8.0-windows/LowCodeApp.Designer.exe",
      "args": ["${workspaceFolder}/DesignProjects/App/design"],
      "cwd": "${workspaceFolder}/Source/Hosts/Common/LowCodeApp.Designer",
      "stopAtEntry": false,
      "console": "internalConsole"
    }
  ]
}
