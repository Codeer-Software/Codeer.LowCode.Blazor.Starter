{
  "Mail": {
    "DefaultInfraName": "Gmail",
    "DefaultBulkInfraName": "Gmail",
    "HistoryModuleName": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataSources": [
    {
      "Name": "SampleSQLite",
      "DataSourceType": "SQLite"
    },
    {
      "Name": "PatternsSQLite",
      "DataSourceType": "SQLite"
    },
    {
      "Name": "Inventory",
      "DataSourceType": "SQLite"
    },
    {
      "Name": "Sfa",
      "DataSourceType": "SQLite"
    },
    {
      "Name": "ProjectManagement",
      "DataSourceType": "SQLite"
    }
  ],
  "AIChat": {
    "RawDataAccessDataSources": []
  },
  "AllowPasswordLogin": true,
  "MobileLoginCallbackUrl": "lowcodeapp://auth",
  "TotpLogin": {
    "Issuer": "LowCodeApp"
  },
  "AuditLog": {
    "Enabled": false,
    "FailureMode": "Strict",
    "RetentionDays": 1825,
    "Categories": [ "Authentication", "DataWrite", "Export", "Admin", "System" ],
    "AttemptCategories": [ "Authentication", "DataWrite", "Export", "Admin" ]
  },
  "AuditLogDatabase": {
    "DataSourceName": "",
    "Table": "audit_log"
  },
  "AuditLogFile": {
    "Directory": ""
  },
  "TemporaryFileTableInfo": [
    {
      "DataSourceName": "SampleSQLite",
      "Table": "temporary_files",
      "GuidColumn": "guid",
      "CreatedDateTimeColumn": "created_date_time"
    },
    {
      "DataSourceName": "PatternsSQLite",
      "Table": "temporary_files",
      "GuidColumn": "guid",
      "CreatedDateTimeColumn": "created_date_time"
    },
    {
      "DataSourceName": "Inventory",
      "Table": "temporary_files",
      "GuidColumn": "guid",
      "CreatedDateTimeColumn": "created_date_time"
    },
    {
      "DataSourceName": "Sfa",
      "Table": "temporary_files",
      "GuidColumn": "guid",
      "CreatedDateTimeColumn": "created_date_time"
    },
    {
      "DataSourceName": "ProjectManagement",
      "Table": "temporary_files",
      "GuidColumn": "guid",
      "CreatedDateTimeColumn": "created_date_time"
    }
  ]
}
