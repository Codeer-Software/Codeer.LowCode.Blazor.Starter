<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS / Windows の App Service 向け。IIS の要求フィルタは本文を既定 30MB で止めるので、その上限を外す。
  添付の大きさの上限は FileField の MaxAllowedSize (無ければ既定) で決まり、サーバーが要求ごとに適用する。
  発行時に ASP.NET Core の設定 (aspNetCore 要素) がこのファイルに追加される。Linux では読まれない。
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="4294967295" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
