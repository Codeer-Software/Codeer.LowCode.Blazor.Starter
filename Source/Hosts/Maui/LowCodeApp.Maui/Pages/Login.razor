@page "/login"
@layout Shared.EmptyLayout
@inject HttpClient HttpClient
@inject ServerConnection Server
@inject NavigationManager NavigationManager

<div class="login-center">
  <div>
    <h1>Login</h1>
    @if (_passwordEnabled)
    {
      <EditForm Model="_login" OnValidSubmit="LoginAsync">
        <div class="mb-2">
          User ID
          <InputText @bind-Value="_login.Id" class="form-control" autocomplete="username" />
        </div>
        <div class="mb-2">
          Password
          <InputText @bind-Value="_login.Password" type="password" class="form-control" autocomplete="current-password" />
        </div>
        <div class="mb-3">
          <InputCheckbox @bind-Value="_login.IsPersistent" id="IsPersistent" />
          <label for="IsPersistent" class="ms-1">Remember me?</label>
        </div>
        <button type="submit" class="btn btn-primary" disabled="@_busy">Login</button>
      </EditForm>
    }
    @foreach (var provider in _providers)
    {
      <div class="mt-2">
        <button type="button" class="btn btn-outline-primary w-100" disabled="@_busy" @onclick="() => ExternalLoginAsync(provider.Name)">Login with @provider.DisplayName</button>
      </div>
    }
    @if (_failed)
    {
      <div class="text-danger mt-3">@(_errorMessage ?? "Login failed.")</div>
    }
  </div>
</div>

@code {
  [SupplyParameterFromQuery]
  public string? ReturnUrl { get; set; }

  class LoginInfo
  {
    public string? Id { get; set; }
    public string? Password { get; set; }
    public bool IsPersistent { get; set; }
  }

  class LoginOptions
  {
    public bool Password { get; set; } = true;
    public List<LoginProvider> Providers { get; set; } = new();
  }

  class LoginProvider
  {
    public string Name { get; set; } = string.Empty;
    public string DisplayName { get; set; } = string.Empty;
  }

  readonly LoginInfo _login = new();
  bool _passwordEnabled = true;
  List<LoginProvider> _providers = new();
  bool _busy;
  bool _failed;
  string? _errorMessage;

  protected override async Task OnInitializedAsync()
  {
    //Web のログイン画面と同じ選択肢: パスワードのフォームと、サーバーに設定された外部 IdP ごとのボタン
    try
    {
      var options = await HttpClient.GetFromJsonAsync<LoginOptions>("api/account/login_options");
      if (options != null)
      {
        _passwordEnabled = options.Password;
        _providers = options.Providers;
      }
    }
    catch { }
  }

  async Task LoginAsync()
  {
    if (string.IsNullOrEmpty(_login.Id) || string.IsNullOrEmpty(_login.Password))
    {
      _failed = true;
      return;
    }

    _busy = true;
    _failed = false;
    try
    {
      var response = await HttpClient.PostAsJsonAsync("api/account/login", _login);
      if (!response.IsSuccessStatusCode)
      {
        _failed = true;
        return;
      }
      SignedIn();
    }
    catch
    {
      _failed = true;
    }
    finally
    {
      _busy = false;
    }
  }

  //外部 IdP: システムブラウザ (埋め込み WebView は Google が拒否する) でサーバーのチャレンジ URL を開く。
  //サーバーは Web と同じ OIDC フローを完了し、使い捨てチケット付きで ServerSettings.LoginCallbackUrl へ戻す。
  //チケットを ServerConnection が持つ認証 Cookie に交換する
  async Task ExternalLoginAsync(string provider)
  {
    _busy = true;
    _failed = false;
    _errorMessage = null;
    try
    {
      var authUrl = new Uri(Server.BaseAddress, $"api/account/login/{Uri.EscapeDataString(provider)}?mobile=true");
      var result = await WebAuthenticator.Default.AuthenticateAsync(authUrl, new Uri(ServerSettings.LoginCallbackUrl));

      if (result.Properties.TryGetValue("error", out var error))
      {
        _failed = true;
        _errorMessage = error switch
        {
          "user_not_registered" => "This account is not registered.",
          "guest_not_allowed" => "Guest accounts are not allowed.",
          "domain_not_allowed" => "This account's domain is not allowed.",
          _ => "Login failed."
        };
        return;
      }
      if (!result.Properties.TryGetValue("ticket", out var ticket))
      {
        _failed = true;
        return;
      }

      var response = await HttpClient.PostAsJsonAsync("api/account/login_ticket", new { Ticket = ticket });
      if (!response.IsSuccessStatusCode)
      {
        _failed = true;
        return;
      }
      SignedIn();
    }
    catch (TaskCanceledException)
    {
      //ユーザーがブラウザを閉じた
    }
    catch
    {
      _failed = true;
    }
    finally
    {
      _busy = false;
    }
  }

  void SignedIn()
  {
    //ログイン前に発行された antiforgery トークンは匿名ユーザーのものなので取り直す
    Server.ResetAntiforgeryToken();

    var returnUrl = string.IsNullOrEmpty(ReturnUrl) || ReturnUrl.StartsWith("login") ? "/" : "/" + ReturnUrl.TrimStart('/');
    NavigationManager.NavigateTo(returnUrl, true);
  }
}
