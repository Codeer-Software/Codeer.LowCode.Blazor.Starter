<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LowCodeApp.Maui.SettingsPage"
             Title="Settings">

  <VerticalStackLayout Padding="24" Spacing="12">
    <Label Text="Server URL" FontAttributes="Bold" />
    <Entry x:Name="ServerUrlEntry" Keyboard="Url" Placeholder="http://192.168.1.10:5085/" />
    <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" Text="Enter a valid http or https URL." />
    <Label x:Name="DefaultLabel" FontSize="12" TextColor="Gray" />
    <HorizontalStackLayout Spacing="12">
      <Button Text="Save" Clicked="OnSaveClicked" />
      <Button Text="Reset to default" Clicked="OnResetClicked" />
    </HorizontalStackLayout>

    <BoxView HeightRequest="1" Color="LightGray" />

    <!-- Release builds have no WebView developer tools and iOS crash logs are unusable for a .NET app
         (mono_ frames only), so app.log (LowCodeApp.Maui.Services.AppLog) is the only way to see why a
         tester's device failed. This lets them read and share it without a debugger. -->
    <Label Text="Diagnostics" FontAttributes="Bold" />
    <ScrollView HeightRequest="200" BackgroundColor="#F2F2F2">
      <Label x:Name="LogLabel" FontFamily="Courier" FontSize="11" Padding="8" LineBreakMode="WordWrap" />
    </ScrollView>
    <HorizontalStackLayout Spacing="12">
      <Button x:Name="ShareLogButton" Text="Share log" Clicked="OnShareLogClicked" />
      <Button x:Name="RefreshLogButton" Text="Refresh" Clicked="OnRefreshLogClicked" />
      <Button x:Name="ClearLogButton" Text="Clear" Clicked="OnClearLogClicked" />
    </HorizontalStackLayout>
  </VerticalStackLayout>

</ContentPage>
