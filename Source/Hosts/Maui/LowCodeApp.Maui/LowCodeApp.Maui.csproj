<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <!-- Mobile clients plus an unpackaged Windows build (Windows only). Add net10.0-maccatalyst for macOS. -->
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <!-- No RootNamespace: it must follow the project name so Razor components and C# files share a namespace. -->
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <Nullable>enable</Nullable>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <!-- Display name -->
    <ApplicationTitle>LowCodeApp</ApplicationTitle>
    <!-- App Identifier (change before publishing to the stores) -->
    <ApplicationId>com.companyname.lowcodeapp</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <!-- Unpackaged (non-MSIX) Windows run/deploy, matching the plain "dotnet build/run" workflow used for Android/iOS. -->
    <WindowsPackageType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</WindowsPackageType>
  </PropertyGroup>
  <!-- Codeer.LowCode.Blazor resolves types by reflection, so app and library assemblies must not be trimmed ("partial" trims only the framework). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TrimMode>partial</TrimMode>
    <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
  </PropertyGroup>
  <!-- iOS devices have no JIT, but the script engine emits IL at runtime. The interpreter allows that. Narrow "all" if performance matters. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <MtouchInterpreter>all</MtouchInterpreter>
  </PropertyGroup>
  <!-- Root components are created by reflection, so the trimmer removes their constructors (CtorNotLocated, HeadOutlet) before any app code runs. Keep the assembly whole. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <TrimmerRootAssembly Include="Microsoft.AspNetCore.Components.Web" RootMode="All" />
  </ItemGroup>
  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />
    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Remove the default Content globs: they bundle these a second time under their full path. MauiAsset below is the only bundling. -->
    <Content Remove="appsettings*.json" />
    <!-- Read at startup via FileSystem.OpenAppPackageFileAsync, so LogicalName must be the bare file name (otherwise iOS bundles a "D:" directory). -->
    <MauiAsset Include="appsettings.json" LogicalName="appsettings.json" />
    <MauiAsset Include="appsettings.Development.json" LogicalName="appsettings.Development.json" Condition="Exists('appsettings.Development.json') And '$(Configuration)' != 'Release'" />
    <!-- Machine specific overrides, gitignored. Bundled in every configuration so a Release build can carry a real server URL. -->
    <MauiAsset Include="appsettings.local.json" LogicalName="appsettings.local.json" Condition="Exists('appsettings.local.json')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <!-- Pins the version the net8.0 shared projects pull in transitively (avoids the NU1605 downgrade error on net10.0). -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Codeer.LowCode.Blazor" Version="1.3.40" />
    <ProjectReference Include="..\..\Common\LowCodeApp.Client.Shared\LowCodeApp.Client.Shared.csproj" />
  </ItemGroup>
  <!-- Publishing identity (bundle id, signing, keystore). Gitignored and imported last so it wins. See LowCodeApp.Maui.local.props.sample. -->
  <Import Project="LowCodeApp.Maui.local.props" Condition="Exists('LowCodeApp.Maui.local.props')" />
</Project>
